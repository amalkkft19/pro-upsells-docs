---
import { Image } from 'astro:assets';
import logo from '../../assets/logo.png';

const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="pu-site-title" aria-label="Pro Upsells Docs, home">
  <Image src={logo} alt="" width={64} height={64} loading="eager" class="pu-logo" />
  <span translate="no"><span class="pu-brand">Pro Upsells</span> <span class="pu-docs">Docs</span></span>
</a>

<style>
  .pu-site-title {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
    color: var(--sl-color-white);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }
  .pu-logo {
    width: 2rem;
    height: 2rem;
    flex: none;
  }
  .pu-docs {
    font-weight: 500;
    color: var(--pu-text-2);
  }
</style>
